<?xml version="1.0" encoding="utf-8"?>

<!-- Layout for én enkelt begivenhed i listen -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="8dp">

    <!-- Indre layout der fungerer som et "card" -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/event_card_background"
        android:elevation="4dp"
        android:padding="14dp">

        <!-- Navn på begivenheden -->
        <TextView
            android:id="@+id/eventNameTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Begivenhed"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Dato -->
        <TextView
            android:id="@+id/eventDateTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Dato"
            android:paddingTop="6dp" />

        <!-- Tidspunkt -->
        <TextView
            android:id="@+id/eventTimeTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tid" />

        <!-- Kort beskrivelse (vises i listen) -->
        <TextView
            android:id="@+id/eventShortDescriptionTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Kort beskrivelse"
            android:paddingTop="6dp"
            android:paddingBottom="10dp" />

        <!-- Knap der åbner detaljeskærmen -->
        <Button
            android:id="@+id/detailsButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Detaljer" />

        <!-- Knap til tilmelding (viser dialog) -->
        <Button
            android:id="@+id/signupButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tilmeld" />

        <!-- Knap der sletter begivenheden -->
        <Button
            android:id="@+id/deleteButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Slet" />

    </LinearLayout>

</LinearLayout>