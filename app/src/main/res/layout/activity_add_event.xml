<?xml version="1.0" encoding="utf-8"?>

<!-- ScrollView gør at brugeren kan scrolle hvis skærmen er for lille -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- LinearLayout placerer elementerne lodret under hinanden -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingBottom="16dp"
        android:paddingTop="60dp">

        <!-- Titel på skærmen -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Opret ny begivenhed"
            android:textSize="24sp"
            android:textStyle="bold"
            android:paddingBottom="20dp" />

        <!-- Input til begivenhedens navn -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Navn"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/nameEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Fx Sommerfest" />

        <!-- Input til dato. Feltet åbner DatePicker i Java-koden -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Dato"
            android:textStyle="bold"
            android:paddingTop="12dp" />

        <EditText
            android:id="@+id/dateEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Fx 12. maj 2026"
            android:focusable="false"
            android:clickable="true" />

        <!-- Input til tid. Feltet åbner TimePicker i Java-koden -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tid"
            android:textStyle="bold"
            android:paddingTop="12dp" />

        <EditText
            android:id="@+id/timeEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Fx 18:00"
            android:focusable="false"
            android:clickable="true" />

        <!-- Kort beskrivelse vises på startskærmen -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Kort beskrivelse"
            android:textStyle="bold"
            android:paddingTop="12dp" />

        <EditText
            android:id="@+id/shortEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Fx Kom til hyggeligt arrangement" />

        <!-- Fuld beskrivelse vises på detaljeskærmen -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Fuld beskrivelse"
            android:textStyle="bold"
            android:paddingTop="12dp" />

        <EditText
            android:id="@+id/fullEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Skriv flere detaljer om begivenheden"
            android:minLines="3" />

        <!-- Link bruges til at åbne browseren fra detaljeskærmen -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Link"
            android:textStyle="bold"
            android:paddingTop="12dp" />

        <EditText
            android:id="@+id/linkEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Fx https://www.google.com" />

        <!-- Gemmer begivenheden -->
        <Button
            android:id="@+id/saveEventButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Gem begivenhed"
            android:layout_marginTop="20dp" />

        <!-- Lukker skærmen uden at gemme -->
        <Button
            android:id="@+id/cancelButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Annuller" />

    </LinearLayout>
</ScrollView>